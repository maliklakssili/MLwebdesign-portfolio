# Postgres connection string — set automatically when you connect a
# database in Vercel > Storage > Connect Store (Neon integration).
DATABASE_URL=postgres://user:password@host/dbname

# Admin login for /admin/quotes (single admin, no user table).
ADMIN_EMAIL=contact@mlwebdesign.ca
ADMIN_PASSWORD=choose-a-strong-password

# Random string used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Resend (email notifications)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=MLwebdesign <notifications@mlwebdesign.ca>
ADMIN_DASHBOARD_URL=https://www.mlwebdesign.ca/admin/quotes
